let replaced: ptr = rep("before needle after", "needle", "FOUND");
print(replaced);
del replaced;

let unchanged: ptr = rep("plain text", "missing", "FOUND");
print(unchanged);
del unchanged;

let long_source: ptr = rep("", "nop", "replacement");
print(long_source);
del long_source;

let long_replaced: ptr = rep("", "mnop", "WXYZ");
print(long_replaced);
del long_replaced;
