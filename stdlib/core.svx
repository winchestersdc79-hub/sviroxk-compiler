// SC Standard Library: small, source-level integer helpers.
// Keep names distinct from compiler built-ins while the module system is minimal.

fn int core_abs(int value) {
    if (value < 0) {
        return 0 - value;
    } else {
        return value;
    }
}

fn int core_min(int left, int right) {
    if (left < right) {
        return left;
    } else {
        return right;
    }
}

fn int core_max(int left, int right) {
    if (left > right) {
        return left;
    } else {
        return right;
    }
}

fn bool core_is_even(int value) {
    return value % 2 == 0;
}
