// SC Standard Library: small, source-level integer helpers.
// Keep names distinct from compiler built-ins while the module system is minimal.

// Returns the absolute magnitude as a 64-bit signed integer, including abs(INT_MIN).
fn long math_abs(int value) {
    if (value < 0) {
        return 0 - (long) value;
    } else {
        return (long) value;
    }
}

// Returns the smaller signed 64-bit integer.
fn long math_min(long left, long right) {
    if (left < right) {
        return left;
    } else {
        return right;
    }
}

// Returns the larger signed 64-bit integer.
fn long math_max(long left, long right) {
    if (left > right) {
        return left;
    } else {
        return right;
    }
}

// Returns whether the signed 64-bit integer is divisible by two.
fn bool math_is_even(long value) {
    return value % 2 == 0;
}
